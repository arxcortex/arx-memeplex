{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arxcortex.github.io/arx-memeplex/schema/idea.schema.json",
  "title": "Memeplex idea list",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "root",
      "year",
      "year_approx",
      "origin_src",
      "origin_note",
      "place",
      "lat",
      "lon",
      "thinkers",
      "parents",
      "plain",
      "summary",
      "ratings",
      "rationale",
      "stories",
      "sources",
      "domain"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "name": {
        "type": "string",
        "maxLength": 90
      },
      "root": {
        "type": "boolean"
      },
      "root_axis": {
        "type": [
          "string",
          "null"
        ]
      },
      "year": {
        "type": "integer",
        "description": "Negative = BC"
      },
      "year_approx": {
        "type": "boolean"
      },
      "origin_src": {
        "type": "string",
        "pattern": "^https://"
      },
      "origin_note": {
        "type": "string"
      },
      "place": {
        "type": [
          "string",
          "null"
        ]
      },
      "lat": {
        "type": [
          "number",
          "null"
        ],
        "minimum": -90,
        "maximum": 90
      },
      "lon": {
        "type": [
          "number",
          "null"
        ],
        "minimum": -180,
        "maximum": 180
      },
      "thinkers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "parents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "plain": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "ratings": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -5,
          "maximum": 5
        }
      },
      "rationale": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "stories": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "domain": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "enum": [
            "politics",
            "philosophy",
            "religion",
            "culture"
          ]
        },
        "description": "Primary domain first: politics (political theory), philosophy, religion, culture (internet/subculture). Used by the page's domain filter."
      },
      "related_currents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "parent_note": {
        "type": "string",
        "description": "Why an idea has no or unusual parents"
      },
      "edge_notes": {
        "type": "object",
        "description": "Keyed by parent id",
        "additionalProperties": {
          "type": "object",
          "required": [
            "status",
            "src",
            "note"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "src": {
              "type": "string",
              "pattern": "^https://"
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "thrives_in": {
        "type": "object",
        "properties": {
          "historical": {
            "type": "boolean"
          },
          "places": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "place"
              ],
              "properties": {
                "place": {
                  "type": "string"
                },
                "src": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "party_alignment": {
        "type": "object",
        "required": [
          "party",
          "strength",
          "src",
          "note"
        ],
        "properties": {
          "party": {
            "enum": [
              "R",
              "D",
              "mixed"
            ]
          },
          "strength": {
            "type": "string"
          },
          "lean": {
            "type": "string"
          },
          "src": {
            "type": "string",
            "pattern": "^https://"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "party_alignment_gb": {
        "type": "object",
        "required": [
          "party",
          "strength",
          "src",
          "note"
        ],
        "properties": {
          "party": {
            "enum": [
              "CON",
              "LAB",
              "REF",
              "LD",
              "GRN",
              "mixed"
            ]
          },
          "strength": {
            "type": "string"
          },
          "lean": {
            "type": "string"
          },
          "blend": {
            "type": "array",
            "items": {
              "enum": [
                "CON",
                "LAB",
                "REF",
                "LD",
                "GRN"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "src": {
            "type": "string",
            "pattern": "^https://"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "party_alignment_fr": {
        "type": "object",
        "required": [
          "party",
          "strength",
          "src",
          "note"
        ],
        "properties": {
          "party": {
            "enum": [
              "RN",
              "REN",
              "LR",
              "PS",
              "LFI",
              "mixed"
            ]
          },
          "strength": {
            "type": "string"
          },
          "lean": {
            "type": "string"
          },
          "blend": {
            "type": "array",
            "items": {
              "enum": [
                "RN",
                "REN",
                "LR",
                "PS",
                "LFI"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "src": {
            "type": "string",
            "pattern": "^https://"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "party_alignment_de": {
        "type": "object",
        "required": [
          "party",
          "strength",
          "src",
          "note"
        ],
        "properties": {
          "party": {
            "enum": [
              "CDU",
              "SPD",
              "GRUENE",
              "AFD",
              "BSW",
              "FDP",
              "mixed"
            ]
          },
          "strength": {
            "type": "string"
          },
          "lean": {
            "type": "string"
          },
          "blend": {
            "type": "array",
            "items": {
              "enum": [
                "CDU",
                "SPD",
                "GRUENE",
                "AFD",
                "BSW",
                "FDP"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "src": {
            "type": "string",
            "pattern": "^https://"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "party_alignment_ru": {
        "type": "object",
        "required": [
          "party",
          "strength",
          "src",
          "note"
        ],
        "properties": {
          "party": {
            "enum": [
              "POWER",
              "SYS",
              "NONSYS",
              "mixed"
            ]
          },
          "strength": {
            "type": "string"
          },
          "lean": {
            "type": "string"
          },
          "blend": {
            "type": "array",
            "items": {
              "enum": [
                "POWER",
                "SYS",
                "NONSYS"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "src": {
            "type": "string",
            "pattern": "^https://"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "party_alignment_cn": {
        "type": "object",
        "required": [
          "party",
          "strength",
          "src",
          "note"
        ],
        "properties": {
          "party": {
            "enum": [
              "CORE",
              "REFORM",
              "LEFT",
              "LIB",
              "mixed"
            ]
          },
          "strength": {
            "type": "string"
          },
          "lean": {
            "type": "string"
          },
          "blend": {
            "type": "array",
            "items": {
              "enum": [
                "CORE",
                "REFORM",
                "LEFT",
                "LIB"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "src": {
            "type": "string",
            "pattern": "^https://"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "party_alignment_jp": {
        "type": "object",
        "required": [
          "party",
          "strength",
          "src",
          "note"
        ],
        "properties": {
          "party": {
            "enum": [
              "LDP",
              "CDP",
              "ISHIN",
              "SANSEI",
              "KOMEI",
              "mixed"
            ]
          },
          "strength": {
            "type": "string"
          },
          "lean": {
            "type": "string"
          },
          "blend": {
            "type": "array",
            "items": {
              "enum": [
                "LDP",
                "CDP",
                "ISHIN",
                "SANSEI",
                "KOMEI"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "src": {
            "type": "string",
            "pattern": "^https://"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "modern_politics": {
        "type": "boolean",
        "description": "Modern politics view tag. Derivable: true whenever the idea has any party_alignment* field."
      },
      "historically_established": {
        "type": "boolean",
        "description": "Modern politics ideas only: true when the idea is at least 25 years old and a named doctrine or tradition that has outlasted any single leader or party term. True ideas stay visible when Hide politics is on."
      },
      "naming_note": {
        "type": "string",
        "description": "Why the idea carries this name; e.g. a practitioners' name preferred over a later critical label"
      },
      "naming_note_src": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    }
  }
}
